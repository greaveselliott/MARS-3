+func TestBatchAuthorityClaimContentionHasOneWinner(t *testing.T) {
+	t.Setenv("BEADS_ACTOR", "bootstrap-engineer")
+	previousActor := actor
+	setActor("bootstrap-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	root := t.TempDir()
+	store := newEmbeddedBootstrapTestStore(t, root)
+	authorizeAuthorityClaimWorkspace(t, root)
+	ctx := context.Background()
+	issue := seedAuthorityClaimFixture(t, store, ctx)
+	script := authorityClaimScript(t, store, ctx, issue.ID, "fixture-attempt-001")
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	for range 2 {
+		go func() {
+			<-start
+			results <- runBatchScriptInTx(t, ctx, store, script)
+		}()
+	}
+	close(start)
+	winners := 0
+	for range 2 {
+		if err := <-results; err == nil {
+			winners++
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("concurrent authority claims produced %d winners, want one", winners)
+	}
+}
