+		t.Fatalf("GetLabels %s: %v", id, err)
+	}
+	sort.Strings(labels)
+	labelsJSON, _ := json.Marshal(labels)
+	dependencies, err := st.GetDependencyRecords(ctx, id)
+	if err != nil {
+		t.Fatalf("GetDependencyRecords %s: %v", id, err)
+	}
+	conditions := make([]authorityDependencyCondition, 0, len(dependencies))
+	for _, dependency := range dependencies {
+		dependencyIssue, readErr := st.GetIssue(ctx, dependency.DependsOnID)
+		if readErr != nil {
+			t.Fatal(readErr)
+		}
+		dependencyMetadataDigest, digestErr := canonicalJSONDigest(dependencyIssue.Metadata)
+		if digestErr != nil {
+			t.Fatal(digestErr)
+		}
+		conditions = append(conditions, authorityDependencyCondition{
+			ID: dependency.DependsOnID, DependencyType: string(dependency.Type),
+			Status: string(dependencyIssue.Status), MetadataSHA256: dependencyMetadataDigest,
+		})
+	}
+	sort.Slice(conditions, func(i, j int) bool { return conditions[i].ID < conditions[j].ID })
+	dependenciesJSON, _ := json.Marshal(conditions)
+	const idempotencyKey = "test-key"
+	const baseCommit = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	postMetadata, err := authorityClaimPostMetadata(issue.Metadata, attemptID, idempotencyKey, baseCommit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return fmt.Sprintf("authority-claim %s expected_status=%s expected_assignee=%s expected_created_at=%s expected_updated_at=%s expected_metadata_sha256=%s expected_labels_sha256=%s expected_dependencies_sha256=%s attempt_id=%s idempotency_key=%s base_commit=%s post_metadata_base64=%s\n",
+		id, issue.Status, issue.Assignee, issue.CreatedAt.UTC().Format(time.RFC3339), issue.UpdatedAt.UTC().Format(time.RFC3339),
+		metadataDigest, digestBytes(labelsJSON), digestBytes(dependenciesJSON), attemptID, idempotencyKey, baseCommit,
+		base64.RawStdEncoding.EncodeToString(postMetadata))
+}
