+func TestBatchAuthorityLifecycleRollbackAndContentionFailClosed(t *testing.T) {
+	previousActor := actor
+	setActor("work-authority-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	root := t.TempDir()
+	store := newEmbeddedBootstrapTestStore(t, root)
+	authorizeAuthorityClaimWorkspace(t, root)
+	ctx := context.Background()
+	issue := seedAuthorityLifecycleFixture(t, store, ctx)
+	transition := authorityLifecycleTransition{
+		Operation: "handoff", PrincipalProfileID: "work-authority-engineer", AttemptID: "execution-attempt-1", CanonicalClaimAttemptID: "canonical-attempt",
+		HeadSHA: strings.Repeat("a", 40), EvidenceRefs: []string{"evidence-handoff"}, NextProfileID: "qa", IdempotencyKey: "handoff-1",
+	}
+	script := authorityTransitionScriptForTest(t, store, ctx, issue.ID, transition) + "dep add DOES-NOT-EXIST ALSO-MISSING\n"
+	if err := runBatchScriptInTx(t, ctx, store, script); err == nil {
+		t.Fatal("post-transition failure did not roll back")
+	}
+	assertAuthorityLifecycleState(t, store, issue.ID, types.StatusInProgress, "in-progress", 2)
+
+	script = authorityTransitionScriptForTest(t, store, ctx, issue.ID, transition)
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	for range 2 {
+		go func() {
+			<-start
+			results <- runBatchScriptInTx(t, ctx, store, script)
+		}()
+	}
+	close(start)
+	winners := 0
+	for range 2 {
+		if err := <-results; err == nil {
+			winners++
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("lifecycle contention winners=%d, want one", winners)
+	}
+	assertAuthorityLifecycleState(t, store, issue.ID, types.StatusInProgress, "in-review", 3)
+}
