+	inReview := applyAuthorityMetadataForTest(t, base, handoff)
+	for _, status := range []string{"blocked", "in-review", "changes-requested", "no-work", "preempted", "cancelled", "failed"} {
+		t.Run(status, func(t *testing.T) {
+			failure := &authorityFailureContext{Reason: "run-" + status, FailureFingerprint: "fingerprint-" + status, Attempt: 1, NextAction: "resume-same-ticket"}
