+		Operation: "handoff", PrincipalProfileID: "work-authority-engineer", AttemptID: "execution-attempt-1", CanonicalClaimAttemptID: "canonical-attempt", HandoffFenceDigest: strings.Repeat("6", 64),
+		HeadSHA: strings.Repeat("a", 40), EvidenceRefs: []string{"evidence-handoff"}, NextProfileID: "qa", IdempotencyKey: "handoff-1",
