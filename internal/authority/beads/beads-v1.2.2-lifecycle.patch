+			post := applyAuthorityMetadataForTest(t, inReview, authorityLifecycleTransition{
+				Operation: "run-disposition", PrincipalProfileID: "delivery-orchestrator", HeadSHA: head, RunStatus: status,
+				Failure: failure, EvidenceRefs: []string{"evidence-run"}, IdempotencyKey: "run-" + status,
