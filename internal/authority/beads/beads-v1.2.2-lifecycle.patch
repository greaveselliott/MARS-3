+func TestBatchAuthorityLifecycleHookWrapperHasNoAuthority(t *testing.T) {
+	previousActor := actor
+	setActor("work-authority-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	root := t.TempDir()
+	store := newEmbeddedBootstrapTestStore(t, root)
+	authorizeAuthorityClaimWorkspace(t, root)
+	ctx := context.Background()
+	issue := seedAuthorityLifecycleFixture(t, store, ctx)
+	script := authorityTransitionScriptForTest(t, store, ctx, issue.ID, authorityLifecycleTransition{
+		Operation: "handoff", PrincipalProfileID: "work-authority-engineer", AttemptID: "execution-attempt-1", CanonicalClaimAttemptID: "canonical-attempt",
+		HeadSHA: strings.Repeat("a", 40), EvidenceRefs: []string{"evidence-handoff"}, NextProfileID: "qa", IdempotencyKey: "handoff-1",
+	})
+	hooksDir := filepath.Join(root, ".beads", "hooks")
+	if err := os.MkdirAll(hooksDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join(root, "lifecycle-hook-fired")
+	t.Setenv("MARS3_HOOK_SENTINEL", sentinel)
+	if err := os.WriteFile(filepath.Join(hooksDir, "on_update"), []byte("#!/bin/sh\n/usr/bin/touch \"$MARS3_HOOK_SENTINEL\"\n"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	wrapped := storage.NewHookFiringStore(store, hooks.NewRunner(hooksDir))
+	if err := runBatchScriptInTx(t, ctx, wrapped, script); err == nil {
+		t.Fatal("hook-wrapped transaction received lifecycle authority")
+	}
+	assertAuthorityLifecycleState(t, store, issue.ID, types.StatusInProgress, "in-progress", 2)
+	time.Sleep(100 * time.Millisecond)
+	if _, err := os.Lstat(sentinel); !os.IsNotExist(err) {
+		t.Fatalf("rejected lifecycle transition executed hook: %v", err)
+	}
+}
