+func assertAuthorityLifecycleState(t *testing.T, store storage.DoltStorage, id string, status types.Status, lifecycle string, sequence float64) {
+	t.Helper()
+	issue, err := store.GetIssue(t.Context(), id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var metadata map[string]interface{}
+	if json.Unmarshal(issue.Metadata, &metadata) != nil || issue.Status != status || metadataStringForTest(issue.Metadata, "lifecycleState") != lifecycle ||
+		metadata["workVersion"].(map[string]interface{})["issueMutationSequence"] != sequence {
+		t.Fatalf("authority lifecycle state=%s/%s", issue.Status, issue.Metadata)
+	}
+}
