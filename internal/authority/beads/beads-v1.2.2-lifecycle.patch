+func TestAuthorityLifecycleEquivalentFailureAllowsOneRetryThenBlocks(t *testing.T) {
+	base := authorityLifecycleMetadataForTest()
+	head := strings.Repeat("a", 40)
+	inReview := applyAuthorityMetadataForTest(t, base, authorityLifecycleTransition{
+		Operation: "handoff", PrincipalProfileID: "work-authority-engineer", AttemptID: "execution", CanonicalClaimAttemptID: "canonical-attempt",
+		HandoffFenceDigest: strings.Repeat("d", 64), HeadSHA: head, EvidenceRefs: []string{"evidence-handoff"}, NextProfileID: "qa", IdempotencyKey: "handoff",
+	})
+	failure := &authorityFailureContext{Reason: "repeatable-failure", FailureFingerprint: "same-fingerprint", Attempt: 1, NextAction: "retry-once"}
+	first := applyAuthorityMetadataForTest(t, inReview, authorityLifecycleTransition{
+		Operation: "run-disposition", PrincipalProfileID: "delivery-orchestrator", HeadSHA: head, RunStatus: "failed", Failure: failure,
+		EvidenceRefs: []string{"evidence-first"}, IdempotencyKey: "run-first",
+	})
+	for _, test := range []struct {
+		name, status string
+		attempt      uint32
+		wantAccepted bool
+	}{
+		{name: "repeat attempt one", status: "failed", attempt: 1},
+		{name: "retry not blocked", status: "failed", attempt: 2},
+		{name: "bounded blocked retry", status: "blocked", attempt: 2, wantAccepted: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			retry := *failure
+			retry.Attempt = test.attempt
+			if test.status == "blocked" {
+				retry.BlockedBy = []string{"M3-P999"}
+			}
+			post, _, _, _, err := authorityTransitionPostMetadata(first, authorityLifecycleTransition{
+				Operation: "run-disposition", PrincipalProfileID: "delivery-orchestrator", HeadSHA: head, RunStatus: test.status, Failure: &retry,
+				EvidenceRefs: []string{"evidence-retry"}, IdempotencyKey: "retry-" + strings.ReplaceAll(test.name, " ", "-"),
+			})
+			if (err == nil) != test.wantAccepted {
+				t.Fatalf("accepted=%v err=%v", err == nil, err)
+			}
+			if test.wantAccepted {
+				third := retry
+				if _, _, _, _, thirdErr := authorityTransitionPostMetadata(post, authorityLifecycleTransition{
+					Operation: "run-disposition", PrincipalProfileID: "delivery-orchestrator", HeadSHA: head, RunStatus: "blocked", Failure: &third,
+					EvidenceRefs: []string{"evidence-third"}, IdempotencyKey: "run-third",
+				}); thirdErr == nil {
+					t.Fatal("third equivalent failure was accepted")
+				}
+			}
+		})
+	}
+}
