+func TestAuthorityLifecycleNonterminalOutcomesRemainRecoverable(t *testing.T) {
+	base := authorityLifecycleMetadataForTest()
+	head := strings.Repeat("a", 40)
+	handoff := authorityLifecycleTransition{
+		Operation: "handoff", PrincipalProfileID: "work-authority-engineer", AttemptID: "execution-attempt", CanonicalClaimAttemptID: "canonical-attempt",
