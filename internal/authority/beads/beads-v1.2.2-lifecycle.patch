+func authorityTransitionScriptForTest(t *testing.T, store storage.DoltStorage, ctx context.Context, id string, transition authorityLifecycleTransition) string {
+	t.Helper()
+	issue, err := store.GetIssue(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	metadataDigest, err := canonicalJSONDigest(issue.Metadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	labels, err := store.GetLabels(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(labels)
+	labelsJSON, _ := json.Marshal(labels)
+	dependencies, err := store.GetDependencyRecords(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conditions := make([]authorityDependencyCondition, 0, len(dependencies))
+	for _, dependency := range dependencies {
+		dependencyIssue, err := store.GetIssue(ctx, dependency.DependsOnID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dependencyDigest, err := canonicalJSONDigest(dependencyIssue.Metadata)
+		if err != nil {
+			t.Fatal(err)
+		}
+		conditions = append(conditions, authorityDependencyCondition{ID: dependency.DependsOnID, DependencyType: string(dependency.Type), Status: string(dependencyIssue.Status), MetadataSHA256: dependencyDigest})
+	}
+	sort.Slice(conditions, func(i, j int) bool {
+		if conditions[i].ID == conditions[j].ID {
+			return conditions[i].DependencyType < conditions[j].DependencyType
+		}
+		return conditions[i].ID < conditions[j].ID
+	})
+	dependenciesJSON, _ := json.Marshal(conditions)
+	transitionJSON, _ := json.Marshal(transition)
+	post, postStatus, removeLabel, addLabel, err := authorityTransitionPostMetadata(issue.Metadata, transition)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return fmt.Sprintf("authority-transition %s expected_status=%s expected_assignee=%s expected_created_at=%s expected_updated_at=%s expected_metadata_sha256=%s expected_labels_sha256=%s expected_dependencies_sha256=%s transition_base64=%s post_status=%s remove_label=%s add_label=%s post_metadata_base64=%s\n",
+		id, issue.Status, issue.Assignee, issue.CreatedAt.UTC().Format(time.RFC3339), issue.UpdatedAt.UTC().Format(time.RFC3339), metadataDigest,
+		digestBytes(labelsJSON), digestBytes(dependenciesJSON), base64.RawStdEncoding.EncodeToString(transitionJSON), postStatus, removeLabel, addLabel,
+		base64.RawStdEncoding.EncodeToString(post))
+}
