@@ -365,0 +387,32 @@ func TestBatchBootstrapClaimServerTransactionFailsBeforeRead(t *testing.T) {
+func TestBatchBootstrapClaimHookWrappedTransactionFailsBeforeRead(t *testing.T) {
+	t.Setenv("BEADS_ACTOR", "bootstrap-engineer")
+	previousActor := actor
+	setActor("bootstrap-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	root := t.TempDir()
+	store := newEmbeddedBootstrapTestStore(t, root)
+	authorizeBootstrapClaimWorkspace(t, root)
+	ctx := context.Background()
+	issue := seedBootstrapClaimFixture(t, store, ctx)
+	script := bootstrapClaimScript(t, store, ctx, issue.ID, issue.UpdatedAt.UTC().Format(time.RFC3339))
+	hooksDir := filepath.Join(root, ".beads", "hooks")
+	if err := os.MkdirAll(hooksDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join(root, "hook-fired")
+	t.Setenv("MARS3_HOOK_SENTINEL", sentinel)
+	hook := []byte("#!/bin/sh\n/usr/bin/touch \"$MARS3_HOOK_SENTINEL\"\n")
+	if err := os.WriteFile(filepath.Join(hooksDir, "on_update"), hook, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	wrapped := storage.NewHookFiringStore(store, hooks.NewRunner(hooksDir))
+	if err := runBatchScriptInTx(t, ctx, wrapped, script); err == nil {
+		t.Fatal("hook-wrapped embedded transaction received bootstrap claim authority")
+	}
+	assertBootstrapIssueBacklog(t, store, issue.ID)
+	time.Sleep(100 * time.Millisecond)
+	if _, err := os.Lstat(sentinel); !os.IsNotExist(err) {
+		t.Fatalf("rejected hook-wrapped transaction executed a workspace hook: %v", err)
+	}
+}
+
