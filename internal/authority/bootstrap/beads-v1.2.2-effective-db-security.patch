+func rejectBootstrapSelectors(beadsDir string) error {
+	if _, err := os.Lstat(filepath.Join(beadsDir, ".env")); err == nil {
+		return fmt.Errorf("bootstrap-claim: Beads environment selector is prohibited")
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("bootstrap-claim: Beads environment selector is not inspectable: %w", err)
+	}
+	configPath := filepath.Join(beadsDir, "config.yaml")
+	info, err := os.Lstat(configPath)
+	if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("bootstrap-claim: Beads config must be one direct regular file")
+	}
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return fmt.Errorf("bootstrap-claim: read Beads config: %w", err)
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		trimmed := strings.TrimSpace(line)
+		if trimmed != "" && !strings.HasPrefix(trimmed, "#") {
+			return fmt.Errorf("bootstrap-claim: Beads config must contain comments only")
+		}
+	}
+	return nil
+}
