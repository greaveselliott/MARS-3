+func assertBootstrapIssueBacklog(t *testing.T, store storage.DoltStorage, id string) {
+	t.Helper()
+	issue, err := store.GetIssue(t.Context(), id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if issue.Status != types.StatusOpen || metadataStringForTest(issue.Metadata, "lifecycleState") != "backlog" {
+		t.Fatalf("rejected bootstrap authority mutated %s to %s/%s", id, issue.Status, metadataStringForTest(issue.Metadata, "lifecycleState"))
+	}
+}
