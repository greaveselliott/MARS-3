+func TestBatchBootstrapClaimServerTransactionFailsBeforeRead(t *testing.T) {
+	t.Setenv("BEADS_ACTOR", "bootstrap-engineer")
+	previousActor := actor
+	setActor("bootstrap-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	root := t.TempDir()
+	store := newTestStoreWithPrefix(t, filepath.Join(root, ".beads", "beads.db"), "tbc")
+	authorizeBootstrapClaimWorkspace(t, root)
+	ctx := context.Background()
+	issue := seedBootstrapClaimFixture(t, store, ctx)
+	script := bootstrapClaimScript(t, store, ctx, issue.ID, issue.UpdatedAt.UTC().Format(time.RFC3339))
+	wrapped := storage.NewHookFiringStore(store, nil)
+	if err := runBatchScriptInTx(t, ctx, wrapped, script); err == nil {
