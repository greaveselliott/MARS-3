diff --git a/internal/storage/embeddeddolt/transaction.go b/internal/storage/embeddeddolt/transaction.go
index 0cdf571d..a61912d4 100644
--- a/internal/storage/embeddeddolt/transaction.go
+++ b/internal/storage/embeddeddolt/transaction.go
@@ -42,0 +43,10 @@ type embeddedTransaction struct {
+// BootstrapAuthority proves the effective database and embedded transaction
+// identity from the same SQL transaction that will perform the one-shot claim.
+func (t *embeddedTransaction) BootstrapAuthority(ctx context.Context) (string, bool, error) {
+	var database string
+	if err := t.tx.QueryRowContext(ctx, "SELECT DATABASE()").Scan(&database); err != nil {
+		return "", false, err
+	}
+	return database, true, nil
+}
+
diff --git a/internal/storage/hook_decorator.go b/internal/storage/hook_decorator.go
index 7af502e4..5ade041b 100644
--- a/internal/storage/hook_decorator.go
+++ b/internal/storage/hook_decorator.go
@@ -432,0 +433,12 @@ type hookTrackingTransaction struct {
+// BootstrapAuthority preserves the direct embedded authority proof through
+// the hook decorator. Server-backed transactions deliberately return false.
+func (t *hookTrackingTransaction) BootstrapAuthority(ctx context.Context) (string, bool, error) {
+	authority, ok := t.Transaction.(interface {
+		BootstrapAuthority(context.Context) (string, bool, error)
+	})
+	if !ok {
+		return "", false, nil
+	}
+	return authority.BootstrapAuthority(ctx)
+}
+
