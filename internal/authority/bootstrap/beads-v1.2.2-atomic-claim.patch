+func TestBatchBootstrapClaimIsOneAtomicTransition(t *testing.T) {
+	t.Setenv("BEADS_ACTOR", "bootstrap-engineer")
+	previousActor := actor
+	setActor("bootstrap-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	tmpDir := t.TempDir()
+	st := newTestStoreWithPrefix(t, filepath.Join(tmpDir, ".beads", "beads.db"), "tbc")
+	authorizeBootstrapClaimWorkspace(t, tmpDir)
+	ctx := context.Background()
+	issue := seedBootstrapClaimFixture(t, st, ctx)
+	script := bootstrapClaimScript(t, st, ctx, issue.ID, issue.UpdatedAt.UTC().Format(time.RFC3339))
+	if err := runBatchScriptInTx(t, ctx, st, script); err != nil {
+		t.Fatalf("bootstrap claim: %v", err)
+	}
+	got, err := st.GetIssue(ctx, issue.ID)
+	if err != nil {
+		t.Fatalf("GetIssue claimed: %v", err)
+	}
+	if got.Status != types.StatusInProgress || got.Assignee != "bootstrap-engineer" {
+		t.Fatalf("claim state = %s/%s, want in_progress/bootstrap-engineer", got.Status, got.Assignee)
+	}
+	var metadata map[string]interface{}
+	if err := json.Unmarshal(got.Metadata, &metadata); err != nil || metadata["lifecycleState"] != "in-progress" {
+		t.Fatalf("post metadata = %s, err=%v", got.Metadata, err)
+	}
+	labels, err := st.GetLabels(ctx, issue.ID)
+	if err != nil {
+		t.Fatalf("GetLabels claimed: %v", err)
+	}
+	sort.Strings(labels)
+	if strings.Join(labels, ",") != "in-progress" {
+		t.Fatalf("labels = %v, want [in-progress]", labels)
+	}
+}
