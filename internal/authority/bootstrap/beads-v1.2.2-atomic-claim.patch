@@ -438,0 +454,256 @@ func runBatchOp(ctx context.Context, tx storage.Transaction, op batchOp) (batchO
+type atomicClaimTransaction interface {
+	ClaimIssue(context.Context, string, string) error
+}
+
+var bootstrapClaimKeys = map[string]bool{
+	"expected_status":               true,
+	"expected_assignee":             true,
+	"expected_created_at":           true,
+	"expected_updated_at":           true,
+	"expected_metadata_sha256":      true,
+	"expected_labels_sha256":        true,
+	"expected_dependency":           true,
+	"expected_dependency_type":      true,
+	"expected_dependency_status":    true,
+	"expected_dependency_lifecycle": true,
+	"expected_dependency_sha256":    true,
+	"post_metadata_base64":          true,
+	"remove_label":                  true,
+	"add_label":                     true,
+}
+
+const (
+	bootstrapDirectBeadsDirEnv  = "MARS3_W001_BOOTSTRAP_DIRECT_BEADS_DIR"
+	bootstrapDirectProjectEnv   = "MARS3_W001_BOOTSTRAP_PROJECT_ID"
+	bootstrapDirectDatabaseEnv  = "MARS3_W001_BOOTSTRAP_DATABASE"
+	bootstrapWorkspaceDigestEnv = "MARS3_W001_BOOTSTRAP_WORKSPACE_SHA256"
+)
+
+type bootstrapWorkspaceMetadata struct {
+	Database     string `json:"database"`
+	Backend      string `json:"backend"`
+	DoltMode     string `json:"dolt_mode"`
+	DoltDatabase string `json:"dolt_database"`
+	ProjectID    string `json:"project_id"`
+}
+
+func verifyBootstrapDirectWorkspace() error {
+	root, err := os.Getwd()
+	if err != nil {
+		return fmt.Errorf("resolve direct bootstrap workspace: %w", err)
+	}
+	resolvedRoot, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return fmt.Errorf("resolve direct bootstrap workspace: %w", err)
+	}
+	directBeadsDir := filepath.Join(resolvedRoot, ".beads")
+	expectedBeadsDir, err := filepath.EvalSymlinks(os.Getenv(bootstrapDirectBeadsDirEnv))
+	if err != nil || !filepath.IsAbs(expectedBeadsDir) || filepath.Clean(expectedBeadsDir) != filepath.Clean(directBeadsDir) {
+		return fmt.Errorf("bootstrap-claim: direct Beads directory is not authority-bound")
+	}
+	if err := rejectBootstrapRedirect(directBeadsDir); err != nil {
+		return err
+	}
+	metadata, entries, err := bootstrapWorkspaceIdentity(resolvedRoot)
+	if err != nil {
+		return err
+	}
+	if metadata.ProjectID != os.Getenv(bootstrapDirectProjectEnv) || metadata.Database != "dolt" || metadata.Backend != "dolt" ||
+		metadata.DoltMode != "embedded" || metadata.DoltDatabase != os.Getenv(bootstrapDirectDatabaseEnv) || metadata.DoltDatabase != "M3" {
+		return fmt.Errorf("bootstrap-claim: direct embedded authority identity is invalid")
+	}
+	digest, err := bootstrapWorkspaceDigest(resolvedRoot, metadata, entries)
+	if err != nil || digest != os.Getenv(bootstrapWorkspaceDigestEnv) {
+		return fmt.Errorf("bootstrap-claim: direct workspace instance digest is invalid")
+	}
+	return nil
+}
+
+func bootstrapWorkspaceDigest(root string, metadata bootstrapWorkspaceMetadata, entries []bootstrapWorkspaceEntry) (string, error) {
+	payload := struct {
+		SchemaVersion int                       `json:"schemaVersion"`
+		ProjectID     string                    `json:"projectId"`
+		Database      string                    `json:"database"`
+		Backend       string                    `json:"backend"`
+		DoltMode      string                    `json:"doltMode"`
+		DoltDatabase  string                    `json:"doltDatabase"`
+		Root          string                    `json:"root"`
+		Entries       []bootstrapWorkspaceEntry `json:"entries"`
+	}{2, metadata.ProjectID, metadata.Database, metadata.Backend, metadata.DoltMode, metadata.DoltDatabase, filepath.Clean(root), entries}
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		return "", err
+	}
+	return digestBytes(encoded), nil
+}
+
+type bootstrapWorkspaceEntry struct {
+	Path   string `json:"path"`
+	Kind   string `json:"kind"`
+	Device uint64 `json:"device"`
+	Inode  uint64 `json:"inode"`
+}
+
+func bootstrapWorkspaceIdentity(root string) (bootstrapWorkspaceMetadata, []bootstrapWorkspaceEntry, error) {
+	var metadata bootstrapWorkspaceMetadata
+	paths := []struct {
+		Relative string
+		Kind     string
+	}{
+		{".", "directory"},
+		{".beads", "directory"},
+		{".beads/metadata.json", "file"},
+		{".beads/embeddeddolt", "directory"},
+		{".beads/embeddeddolt/M3", "directory"},
+	}
+	entries := make([]bootstrapWorkspaceEntry, 0, len(paths))
+	for _, required := range paths {
+		path := filepath.Join(root, filepath.FromSlash(required.Relative))
+		info, err := os.Lstat(path)
+		if err != nil || info.Mode()&os.ModeSymlink != 0 || required.Kind == "directory" && !info.IsDir() || required.Kind == "file" && !info.Mode().IsRegular() {
+			return metadata, nil, fmt.Errorf("bootstrap-claim: direct workspace authority path is invalid: %s", required.Relative)
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok {
+			return metadata, nil, fmt.Errorf("bootstrap-claim: direct workspace path lacks stable identity: %s", required.Relative)
+		}
+		entries = append(entries, bootstrapWorkspaceEntry{required.Relative, required.Kind, uint64(stat.Dev), uint64(stat.Ino)})
+	}
+	data, err := os.ReadFile(filepath.Join(root, ".beads", "metadata.json"))
+	if err != nil {
+		return metadata, nil, fmt.Errorf("bootstrap-claim: read direct workspace metadata: %w", err)
+	}
+	decoder := json.NewDecoder(strings.NewReader(string(data)))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&metadata); err != nil {
+		return metadata, nil, fmt.Errorf("bootstrap-claim: direct workspace metadata is invalid: %w", err)
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		return metadata, nil, fmt.Errorf("bootstrap-claim: direct workspace metadata must be one object")
+	}
+	return metadata, entries, nil
+}
+
+func rejectBootstrapRedirect(beadsDir string) error {
+	_, err := os.Lstat(filepath.Join(beadsDir, "redirect"))
+	if err == nil {
+		return fmt.Errorf("bootstrap-claim: Beads redirect is prohibited")
+	}
+	if !os.IsNotExist(err) {
+		return fmt.Errorf("bootstrap-claim: Beads redirect state is not inspectable: %w", err)
+	}
+	return nil
+}
+
+func runBootstrapClaimBatchOp(ctx context.Context, tx storage.Transaction, op batchOp, actor string) (batchOpResult, error) {
+	result := batchOpResult{Line: op.line, Op: op.cmd}
+	if err := verifyBootstrapDirectWorkspace(); err != nil {
+		return result, err
+	}
+	if len(op.args) != 15 {
+		return result, fmt.Errorf("bootstrap-claim requires <id> and exactly fourteen key=value arguments")
+	}
+	id := op.args[0]
+	values := make(map[string]string, len(op.args)-1)
+	for _, token := range op.args[1:] {
+		parts := strings.SplitN(token, "=", 2)
+		if len(parts) != 2 || parts[0] == "" || !bootstrapClaimKeys[parts[0]] {
+			return result, fmt.Errorf("bootstrap-claim: invalid argument %q", token)
+		}
+		if _, exists := values[parts[0]]; exists {
+			return result, fmt.Errorf("bootstrap-claim: duplicate argument %q", parts[0])
+		}
+		values[parts[0]] = parts[1]
+	}
+	if len(values) != len(bootstrapClaimKeys) {
+		return result, fmt.Errorf("bootstrap-claim: every required argument must occur exactly once")
+	}
+	claimTx, ok := tx.(atomicClaimTransaction)
+	if !ok {
+		return result, fmt.Errorf("bootstrap-claim: storage transaction lacks native CAS claim support")
+	}
+	issue, err := tx.GetIssue(ctx, id)
+	if err != nil {
+		return result, fmt.Errorf("bootstrap-claim: read issue: %w", err)
+	}
+	if string(issue.Status) != values["expected_status"] || issue.Assignee != values["expected_assignee"] ||
+		issue.CreatedAt.UTC().Format(time.RFC3339) != values["expected_created_at"] ||
+		issue.UpdatedAt.UTC().Format(time.RFC3339) != values["expected_updated_at"] {
+		return result, fmt.Errorf("bootstrap-claim: issue precondition mismatch")
+	}
+	metadataDigest, err := canonicalJSONDigest(issue.Metadata)
+	if err != nil || metadataDigest != values["expected_metadata_sha256"] {
+		return result, fmt.Errorf("bootstrap-claim: metadata precondition mismatch")
+	}
+	labels, err := tx.GetLabels(ctx, id)
+	if err != nil {
+		return result, fmt.Errorf("bootstrap-claim: read labels: %w", err)
+	}
+	sort.Strings(labels)
+	labelsJSON, _ := json.Marshal(labels)
+	if digestBytes(labelsJSON) != values["expected_labels_sha256"] {
+		return result, fmt.Errorf("bootstrap-claim: label precondition mismatch")
+	}
+	dependencies, err := tx.GetDependencyRecords(ctx, id)
+	if err != nil || len(dependencies) != 1 || dependencies[0].DependsOnID != values["expected_dependency"] ||
+		string(dependencies[0].Type) != values["expected_dependency_type"] {
+		return result, fmt.Errorf("bootstrap-claim: dependency precondition mismatch")
+	}
+	dependency, err := tx.GetIssue(ctx, dependencies[0].DependsOnID)
+	if err != nil || string(dependency.Status) != values["expected_dependency_status"] ||
+		metadataStringValue(dependency.Metadata, "lifecycleState") != values["expected_dependency_lifecycle"] {
+		return result, fmt.Errorf("bootstrap-claim: dependency state mismatch")
+	}
+	dependencyJSON, _ := json.Marshal(map[string]interface{}{"dependencies": []interface{}{map[string]interface{}{
+		"dependency_type": string(dependencies[0].Type), "id": dependencies[0].DependsOnID,
+		"lifecycleState": metadataStringValue(dependency.Metadata, "lifecycleState"), "status": string(dependency.Status),
+	}}})
+	if digestBytes(dependencyJSON) != values["expected_dependency_sha256"] {
+		return result, fmt.Errorf("bootstrap-claim: dependency digest mismatch")
+	}
+	postMetadata, err := base64.RawStdEncoding.DecodeString(values["post_metadata_base64"])
+	if err != nil || !json.Valid(postMetadata) {
+		return result, fmt.Errorf("bootstrap-claim: post metadata is not valid unpadded base64 JSON")
+	}
+	if err := claimTx.ClaimIssue(ctx, id, actor); err != nil {
+		return result, fmt.Errorf("bootstrap-claim: native CAS claim: %w", err)
+	}
+	if err := tx.UpdateIssue(ctx, id, map[string]interface{}{"metadata": json.RawMessage(postMetadata)}, actor); err != nil {
+		return result, fmt.Errorf("bootstrap-claim: metadata update: %w", err)
+	}
+	if err := tx.RemoveLabel(ctx, id, values["remove_label"], actor); err != nil {
+		return result, fmt.Errorf("bootstrap-claim: remove lifecycle label: %w", err)
+	}
+	if err := tx.AddLabel(ctx, id, values["add_label"], actor); err != nil {
+		return result, fmt.Errorf("bootstrap-claim: add lifecycle label: %w", err)
+	}
+	result.Target = id
+	return result, nil
+}
+
+func canonicalJSONDigest(data []byte) (string, error) {
+	var decoded interface{}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		return "", err
+	}
+	canonical, err := json.Marshal(decoded)
+	if err != nil {
+		return "", err
+	}
+	return digestBytes(canonical), nil
+}
+
+func metadataStringValue(data []byte, key string) string {
+	var values map[string]interface{}
+	if json.Unmarshal(data, &values) != nil {
+		return ""
+	}
+	value, _ := values[key].(string)
+	return value
+}
+
+func digestBytes(data []byte) string {
+	digest := sha256.Sum256(data)
+	return hex.EncodeToString(digest[:])
+}
+
