+
+func seedBootstrapClaimFixture(t *testing.T, st storage.DoltStorage, ctx context.Context) *types.Issue {
+	t.Helper()
+	seedBatchTestIssues(t, ctx, st, "tbc-dep", "tbc-work")
+	if err := st.CloseIssue(ctx, "tbc-dep", "fixture prerequisite", "test", ""); err != nil {
+		t.Fatalf("CloseIssue dependency: %v", err)
+	}
+	if err := st.UpdateIssue(ctx, "tbc-dep", map[string]interface{}{
+		"metadata": json.RawMessage(`{"lifecycleState":"done"}`),
+	}, "test"); err != nil {
+		t.Fatalf("UpdateIssue dependency metadata: %v", err)
