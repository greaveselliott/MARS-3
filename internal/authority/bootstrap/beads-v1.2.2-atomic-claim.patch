+	}, "test"); err != nil {
+		t.Fatalf("AddDependency fixture: %v", err)
+	}
+	issue, err := st.GetIssue(ctx, "tbc-work")
+	if err != nil {
+		t.Fatalf("GetIssue fixture: %v", err)
+	}
