+func TestBatchBootstrapClaimContentionHasOneWinner(t *testing.T) {
+	t.Setenv("BEADS_ACTOR", "bootstrap-engineer")
+	previousActor := actor
+	setActor("bootstrap-engineer")
+	t.Cleanup(func() { setActor(previousActor) })
+	tmpDir := t.TempDir()
+	st := newTestStoreWithPrefix(t, filepath.Join(tmpDir, ".beads", "beads.db"), "tbc")
+	ctx := context.Background()
+	issue := seedBootstrapClaimFixture(t, st, ctx)
+	script := bootstrapClaimScript(t, st, ctx, issue.ID, issue.UpdatedAt.UTC().Format(time.RFC3339))
+
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	for range 2 {
+		go func() {
+			<-start
+			results <- runBatchScriptInTx(t, ctx, st, script)
+		}()
+	}
+	close(start)
+	winners := 0
+	for range 2 {
+		if err := <-results; err == nil {
+			winners++
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("concurrent bootstrap claims produced %d winners, want exactly one", winners)
+	}
+	got, err := st.GetIssue(ctx, issue.ID)
+	if err != nil {
+		t.Fatalf("GetIssue after contention: %v", err)
+	}
+	if got.Status != types.StatusInProgress || metadataStringForTest(got.Metadata, "lifecycleState") != "in-progress" {
+		t.Fatalf("contention postimage = %s/%s, want in_progress/in-progress", got.Status, metadataStringForTest(got.Metadata, "lifecycleState"))
+	}
+}
+
+func metadataStringForTest(data json.RawMessage, key string) string {
+	var values map[string]interface{}
+	if json.Unmarshal(data, &values) != nil {
+		return ""
+	}
+	value, _ := values[key].(string)
+	return value
+}
